# Base de datos remota (Turso / libSQL). Sin estas dos variables se usa data/planet.db en tu PC.
TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
TURSO_AUTH_TOKEN=

# Firma de las sesiones: texto largo y aleatorio (obligatorio en Vercel)
SESSION_SECRET=

# Contraseña inicial del usuario "admin" (solo se usa al crear la base por primera vez)
ADMIN_PASSWORD=

# En producción con HTTPS
COOKIE_SECURE=true
